{
  "name": "fx-risk-cli",
  "version": "0.3.0",
  "private": true,
  "description": "Deterministic FX position sizing, exposure valuation, drawdown-aware risk budgeting, and risk/reward calculations from the command line.",
  "type": "module",
  "bin": {
    "fx-risk": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
